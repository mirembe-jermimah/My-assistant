PORT=3000
# Optional: restrict Jermi's Assistant to chosen local folders, separated by semicolons.
JERMI_FS_ROOTS=
# Optional: store Jermi's Assistant's local database in another folder.
JERMI_DATA_DIR=
# Choose one conversation engine. For a local Ollama-compatible model:
JERMI_LOCAL_MODEL=
JERMI_LOCAL_AI_URL=http://127.0.0.1:11434/v1
# Or use OpenAI. Relevant file excerpts will be sent to OpenAI when chatting.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Optional alternate local voice runtime paths.
JERMI_VOICE_PYTHON=
JERMI_VOICE_MODEL=
# Set to 1 only when you intentionally want to pause automatic local indexing.
JERMI_DISABLE_AUTO_SCAN=0
# Only behind a trusted HTTPS reverse proxy.
TRUST_PROXY=0
